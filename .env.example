# ---- Public (safe to expose; these are NEXT_PUBLIC_ on purpose) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---- Server-only (never prefix with NEXT_PUBLIC_) ----
# Email of the single Supabase Auth admin user. Visitors never see or type this.
ADMIN_EMAIL=admin@example.com
# Random secret (>= 32 chars) used to HMAC client IPs for login throttling. Generate: openssl rand -hex 32
LOGIN_HMAC_SECRET=
# NOTE: the Supabase service-role key is NOT used and must NOT be added. All privileged
# work runs with the admin's own session under Row Level Security.
